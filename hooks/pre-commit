#!/usr/bin/env bash
# dev-pipeline pre-commit hook
# Fast-fails on lint / typecheck for staged JS/TS files.
# Bypass for incidents: git commit --no-verify
#
# Auto-detects monorepo (pnpm/turbo/nx) vs single-package layout.
# Skips itself entirely on repos NOT managed by dev-pipeline so it is safe to
# install globally via core.hooksPath. A foreign hook found at install time
# is preserved as <name>.next; this hook chains to it.

set -e

HOOK_DIR="$(dirname "$0")"
HOOK_NAME="$(basename "$0")"
NEXT_HOOK="$HOOK_DIR/$HOOK_NAME.next"

chain_next() {
  if [[ -x "$NEXT_HOOK" ]]; then
    "$NEXT_HOOK" "$@"
  fi
}

# ── Is this a dev-pipeline-managed repo? ────────────────────────────────────
# Marker: .claude/pipeline-state.json (created by /dev-pipeline:init STEP 2).
if [[ ! -f .claude/pipeline-state.json ]]; then
  chain_next "$@"
  exit 0
fi

# ── Identify what's staged ──────────────────────────────────────────────────
STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)"
if [[ -z "$STAGED" ]] || [[ ! -f package.json ]]; then
  chain_next "$@"
  exit 0
fi

# ── Pick package manager ────────────────────────────────────────────────────
if [[ -f pnpm-lock.yaml ]]; then PM=pnpm
elif [[ -f yarn.lock ]];      then PM=yarn
else                                PM=npm
fi

IS_MONOREPO=0
if [[ -f pnpm-workspace.yaml ]] || [[ -f turbo.json ]] || [[ -f nx.json ]] || \
   grep -q '"workspaces"' package.json 2>/dev/null; then
  IS_MONOREPO=1
fi

# ── lint ────────────────────────────────────────────────────────────────────
if grep -q '"lint"' package.json 2>/dev/null; then
  echo "→ pre-commit: $PM lint"
  if ! $PM run lint --silent 2>&1 | tail -40; then
    echo "🛑 COMMIT BLOCKED — lint failed."
    exit 1
  fi
elif [[ -f eslint.config.js ]] || [[ -f eslint.config.mjs ]] || \
     [[ -f .eslintrc.json ]] || [[ -f .eslintrc.js ]]; then
  echo "→ pre-commit: eslint (staged only)"
  echo "$STAGED" | xargs npx --no-install eslint --quiet 2>/dev/null || {
    echo "🛑 COMMIT BLOCKED — eslint errors. Run \`$PM lint\` for details."
    exit 1
  }
fi

# ── typecheck ───────────────────────────────────────────────────────────────
if grep -q '"type-check"' package.json 2>/dev/null; then
  echo "→ pre-commit: $PM type-check"
  if ! $PM run type-check --silent 2>&1 | tail -40; then
    echo "🛑 COMMIT BLOCKED — TypeScript errors."
    exit 1
  fi
elif [[ -f tsconfig.json ]] && [[ "$IS_MONOREPO" -eq 0 ]]; then
  echo "→ pre-commit: tsc --noEmit"
  if ! npx --no-install tsc --noEmit 2>&1 | tail -40; then
    echo "🛑 COMMIT BLOCKED — TypeScript errors."
    exit 1
  fi
fi

# ── fast tests (optional) ───────────────────────────────────────────────────
if grep -q '"test:fast"' package.json 2>/dev/null; then
  echo "→ pre-commit: $PM test:fast"
  $PM run test:fast --silent || {
    echo "🛑 COMMIT BLOCKED — fast tests failed."
    exit 1
  }
fi

echo "✅ pre-commit passed"
chain_next "$@"
exit 0
