#!/bin/bash
# learning-watcher-privacy-gate  (installed by tools/learning-watcher/install.sh)
#
# Refuses a push when the lines it ADDS contain secrets, emails, prices, client
# domains, people's names, user paths or private terms (privacy_lint.py).
# Repos with `git config learning-watcher.public true` also refuse CJK text.
# Escape hatch for text you have checked is public: PRIVACY_LINT_SKIP=1 git push
LINT="${LW_HOME:-$HOME/.claude/learning}/bin/privacy_lint.py"
if [ -n "${PRIVACY_LINT_SKIP:-}" ]; then
  echo "privacy gate: skipped (PRIVACY_LINT_SKIP set)" >&2; exit 0
fi
if [ ! -f "$LINT" ]; then
  echo "privacy gate: $LINT is missing — run tools/learning-watcher/install.sh (or PRIVACY_LINT_SKIP=1 git push)" >&2
  exit 1
fi
PUB=""
[ "$(git config --get learning-watcher.public)" = "true" ] && PUB="--public"
Z=0000000000000000000000000000000000000000
rc=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$Z" ] && continue                      # deleting a remote branch
  if [ "$remote_sha" = "$Z" ]; then                         # new branch: what main lacks
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)"
  else
    base="$remote_sha"
  fi
  python3 "$LINT" --git-range "$base..$local_sha" $PUB --quiet || rc=1
done
[ $rc -ne 0 ] && echo "push refused by the privacy gate (learning watcher). Rewrite the text generically, then push again." >&2
exit $rc
