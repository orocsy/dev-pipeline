{
  "$schema": "./deps.schema.json",
  "version": 2,
  "description": "External skills/plugins/MCPs that dev-pipeline references. Used by /dev-pipeline:refresh-deps to verify presence + freshness AND by /dev-pipeline:skill-doctor to diagnose drift. Names here SHOULD match the actual plugin/skill `name` on disk; if upstream renamed, list the old name(s) under `supersedes[]`.",
  "owned": [
    "miu-methodology",
    "project-detector",
    "skill-router",
    "prd-parser",
    "code-refactor",
    "cloud-design-patterns",
    "excalidraw-diagram-generator"
  ],
  "marketplaces": [
    {
      "name": "claude-plugins-official",
      "source": { "type": "github", "repo": "anthropics/claude-plugins-public" },
      "url": "https://github.com/anthropics/claude-plugins-public.git",
      "required": true,
      "provides": ["code-review", "commit-commands", "context7", "frontend-design", "typescript-lsp", "vercel"]
    },
    {
      "name": "local",
      "source": { "type": "local", "path": "~/.claude/plugins/marketplaces/local" },
      "required": true,
      "provides": ["dev-pipeline"]
    }
  ],
  "external": {
    "plugins": [
      {
        "name": "code-review",
        "required": true,
        "usedBy": ["review", "deliver", "fix", "fix-review"],
        "fallback": "owned reviewers (deep + typescript + security) still run",
        "marketplaceHint": "claude-plugins-official"
      },
      {
        "name": "commit-commands",
        "required": false,
        "usedBy": ["deliver"],
        "fallback": "git commit/push run directly",
        "marketplaceHint": "claude-plugins-official"
      },
      {
        "name": "vercel",
        "required": false,
        "usedBy": ["deploy", "scaffold-from-prd"],
        "marketplaceHint": "claude-plugins-official",
        "note": "Deployment plugin (not a coding-style skill). Source URL: https://github.com/vercel/vercel-plugin"
      }
    ],
    "skills": [
      {
        "name": "frontend-design",
        "required": false,
        "trigger": "UI/design phase",
        "usedBy": ["plan"],
        "marketplaceHint": "claude-plugins-official",
        "supersedes": ["ui-ux-pro-max", "web-design-guidelines"],
        "note": "Replaces ui-ux-pro-max + web-design-guidelines. Single skill covers both concerns."
      },
      {
        "name": "vercel-react-best-practices",
        "required": false,
        "trigger": "next/react detected",
        "usedBy": ["plan", "implement", "detect"],
        "status": "search-required",
        "note": "Not in claude-plugins-official as of 2026-05. Likely deprecated community skill. skill-doctor --search to look upstream."
      },
      {
        "name": "vercel-composition-patterns",
        "required": false,
        "trigger": "next/react detected",
        "usedBy": ["plan", "implement", "detect"],
        "status": "search-required"
      },
      {
        "name": "nestjs-best-practices",
        "required": false,
        "trigger": "nestjs detected",
        "usedBy": ["implement", "detect"],
        "status": "search-required"
      },
      {
        "name": "nestjs-modules",
        "required": false,
        "trigger": "nestjs detected",
        "usedBy": ["implement"],
        "status": "search-required"
      },
      {
        "name": "mastering-typescript",
        "required": false,
        "trigger": "typescript detected",
        "usedBy": ["implement"],
        "status": "search-required"
      },
      {
        "name": "websocket-engineer",
        "required": false,
        "trigger": "websocket dependency",
        "usedBy": ["implement"],
        "status": "search-required"
      },
      {
        "name": "nodejs-architecture",
        "required": false,
        "trigger": "node backend",
        "usedBy": ["implement"],
        "status": "search-required",
        "family": "nodejs-*"
      },
      {
        "name": "nodejs-database-orm",
        "required": false,
        "trigger": "prisma/typeorm detected",
        "usedBy": ["implement"],
        "status": "search-required",
        "family": "nodejs-*"
      },
      {
        "name": "nodejs-caching-redis",
        "required": false,
        "trigger": "redis detected",
        "usedBy": ["implement"],
        "status": "search-required",
        "family": "nodejs-*"
      },
      {
        "name": "nodejs-docker-production",
        "required": false,
        "trigger": "Dockerfile detected",
        "usedBy": ["implement"],
        "status": "search-required",
        "family": "nodejs-*"
      },
      {
        "name": "nodejs-testing",
        "required": false,
        "trigger": "jest/vitest detected",
        "usedBy": ["implement"],
        "status": "search-required",
        "family": "nodejs-*"
      },
      {
        "name": "nodejs-error-handling",
        "required": false,
        "trigger": "node backend",
        "usedBy": ["implement"],
        "status": "search-required",
        "family": "nodejs-*"
      },
      {
        "name": "nodejs-security",
        "required": false,
        "trigger": "auth/payment paths",
        "usedBy": ["implement"],
        "status": "search-required",
        "family": "nodejs-*"
      }
    ],
    "mcps": [
      { "name": "stitch-mcp",  "required": false, "via": "npx @_davideast/stitch-mcp", "usedBy": ["plan/design"] },
      { "name": "context7",    "required": false, "via": "MCP server",                  "usedBy": ["any implement phase needing docs"] }
    ]
  },
  "hybridSkills": [
    {
      "owned": "skill-router",
      "composesWith": ["frontend-design", "vercel-react-best-practices", "vercel-composition-patterns"],
      "compatNote": "skill-router routes TO these public skills by name. After every public-skill update, re-check the routing table for renames/removals."
    },
    {
      "owned": "project-detector",
      "composesWith": [
        "mastering-typescript",
        "nestjs-best-practices",
        "nestjs-modules",
        "nodejs-architecture",
        "nodejs-database-orm",
        "nodejs-caching-redis",
        "nodejs-docker-production",
        "nodejs-testing",
        "nodejs-error-handling",
        "nodejs-security"
      ],
      "compatNote": "project-detector maps detected tech to public-skill HIGH/MEDIUM tier names. Names listed explicitly (no wildcards) so each is independently resolved against deps.json — entries with status: search-required are suppressed from drift output."
    }
  ]
}
